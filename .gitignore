# Automatische Backups von KiCad ignorieren
kicad/*-backups/
kicad/*.kicad_sch-bak
kicad/*.kicad_pcb-bak

# Lokale Ansichts- und Sperrdateien ignorieren (ändern sich ständig)
kicad/*.kicad_prl
kicad/~*.lck
kicad/fp-info-cache

# Fertigungsdaten (Gerber, Bohrdaten, ZIPs) ignorieren
# (Diese Daten können jederzeit wieder aus KiCad exportiert werden)
kicad/manufacturing/

# SvelteKit & Frontend
node_modules/
.svelte-kit/
build/
.env
.env.*
!.env.example

# TypeScript
*.tsbuildinfo

# OS & Editoren
.DS_Store
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Rust & Tauri
# Ignoriert die kompilierten Rust-Binärdateien und Abhängigkeiten
src-tauri/target/

# Temporäre Tauri-Build-Dateien
src-tauri/gen/

# Rust-Absturzberichte
src-tauri/*.bk

